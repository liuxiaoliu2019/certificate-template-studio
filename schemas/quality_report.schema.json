{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/certificate-template-studio/quality_report.schema.json",
  "title": "Quality-managed certificate candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "orientation", "candidates", "selected_candidate_id", "action", "default_visible_candidate_ids", "other_qualified_candidate_ids", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "orientation": {"enum": ["landscape", "portrait"]},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "selected_candidate_id": {"type": ["string", "null"]},
    "action": {"enum": ["submit_best", "repair_best", "regenerate_best", "blocked"]},
    "default_visible_candidate_ids": {"type": "array", "maxItems": 1, "items": {"type": "string"}},
    "other_qualified_candidate_ids": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "artifact", "scores", "total", "hard_failures", "qualified", "used_character_ids", "character_identity_reports"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "artifact": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
        },
        "scores": {
          "type": "object", "additionalProperties": false,
          "required": ["style_dna", "certificate_style", "composition", "title", "safe_zones", "orientation_consistency", "text_cleanliness"],
          "properties": {
            "style_dna": {"type": "integer", "minimum": 0, "maximum": 20},
            "certificate_style": {"type": "integer", "minimum": 0, "maximum": 20},
            "composition": {"type": "integer", "minimum": 0, "maximum": 20},
            "title": {"type": "integer", "minimum": 0, "maximum": 15},
            "safe_zones": {"type": "integer", "minimum": 0, "maximum": 10},
            "orientation_consistency": {"type": "integer", "minimum": 0, "maximum": 10},
            "text_cleanliness": {"type": "integer", "minimum": 0, "maximum": 5}
          }
        },
        "total": {"type": "integer", "minimum": 0, "maximum": 100},
        "hard_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "qualified": {"type": "boolean"},
        "used_character_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "character_identity_reports": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
