{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/certificate-template-studio/schemas/workflow_event.schema.json",
  "title": "Certificate Workflow Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "mode", "action", "from_stage", "to_stage", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "pattern": "^e[0-9]{4,}$" },
    "mode": { "enum": ["textbook_cover", "template_bidirectional"] },
    "action": { "type": "string", "minLength": 1 },
    "from_stage": { "type": "string", "minLength": 1 },
    "to_stage": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
