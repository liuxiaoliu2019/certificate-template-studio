{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/certificate-template-studio/source_fingerprint.schema.json",
  "title": "Project source fingerprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "source", "controls", "characters", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["textbook_cover", "template_bidirectional"]},
    "source": {"$ref": "#/$defs/file"},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landscape", "portrait"],
      "properties": {
        "landscape": {"$ref": "#/$defs/file"},
        "portrait": {"$ref": "#/$defs/file"}
      }
    },
    "characters": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/file"}
    },
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
