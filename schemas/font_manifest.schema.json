{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/certificate-template-studio/font_manifest.schema.json",
  "title": "Certificate Template Studio bundled font manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "license", "role_candidates", "fonts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "license": {"const": "OFL-1.1"},
    "role_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_serif", "modern_sans", "ceremonial_display", "children_round"],
      "properties": {
        "formal_serif": {"$ref": "#/$defs/font_ids"},
        "modern_sans": {"$ref": "#/$defs/font_ids"},
        "ceremonial_display": {"$ref": "#/$defs/font_ids"},
        "children_round": {"$ref": "#/$defs/font_ids"}
      }
    },
    "fonts": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/font"}
    }
  },
  "$defs": {
    "font_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "family", "version", "file", "sha256", "license_file",
        "metadata_file", "source_url", "scripts"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "family": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "file": {"type": "string", "pattern": "^[^\\\\/]+/[^\\\\/]+\\.ttf$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "license_file": {"type": "string", "pattern": "^[^\\\\/]+/OFL\\.txt$"},
        "metadata_file": {"type": "string", "pattern": "^[^\\\\/]+/METADATA\\.pb$"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/google/fonts/"},
        "scripts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["latin", "simplified_chinese"]}
        }
      }
    }
  }
}
