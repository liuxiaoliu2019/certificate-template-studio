{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/certificate-template-studio/schemas/master_style_profile.schema.json",
  "title": "Certificate Master Style Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "textbook_key",
    "source_style_dna",
    "approved_style_profile",
    "master_title",
    "masters",
    "title_rules",
    "composition_invariants",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1", "1.2"] },
    "textbook_key": { "type": "string", "minLength": 1 },
    "source_style_dna": { "type": "string", "minLength": 1 },
    "source_character_identity": { "type": ["string", "null"] },
    "used_character_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "approved_style_profile": { "$ref": "certificate_style_profile.schema.json" },
    "master_title": { "type": "string", "minLength": 1 },
    "masters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landscape", "portrait"],
      "properties": {
        "landscape": { "type": "string", "minLength": 1 },
        "portrait": { "type": ["string", "null"] }
      }
    },
    "title_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["only_readable_text", "horizontal_center_x_percent", "portrait_up_shift_cm"],
      "properties": {
        "only_readable_text": { "const": true },
        "horizontal_center_x_percent": { "const": 50 },
        "portrait_up_shift_cm": { "const": 1.5 }
      }
    },
    "composition_invariants": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "enum": ["1.1", "1.2"] } } },
      "then": { "required": ["source_character_identity", "used_character_ids"] }
    }
  ]
}
