{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/certificate-template-studio/derivative_manifest.schema.json",
  "title": "Dual-orientation title derivative",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "slug", "source_masters", "title_family", "outputs", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "source_masters": {
      "type": "object", "additionalProperties": false, "required": ["landscape", "portrait"],
      "properties": {"landscape": {"$ref": "#/$defs/file"}, "portrait": {"$ref": "#/$defs/file"}}
    },
    "title_family": {"enum": ["formal_two_tier", "modern_two_tier", "ceremonial_arc", "double_ribbon", "playful_children", "illustrated_integrated"]},
    "outputs": {
      "type": "object", "additionalProperties": false, "required": ["landscape", "portrait"],
      "properties": {"landscape": {"$ref": "#/$defs/output"}, "portrait": {"$ref": "#/$defs/output"}}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["image", "report", "title_plan"], "properties": {"image": {"$ref": "#/$defs/file"}, "report": {"$ref": "#/$defs/file"}, "title_plan": {"$ref": "#/$defs/file"}}}
  }
}
